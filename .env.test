# Database credentials
DB_USER=postgres
DB_PASSWORD=test_password
DB_NAME=life_tracker_test
MONGO_USER=test_user
MONGO_PASSWORD=test_password
MONGO_DATABASE=life_tracker_test

# Port mappings (different from dev to avoid conflicts)
DB_PORT=5433
MONGO_PORT=27018

# Container names
POSTGRES_CONTAINER_NAME=golang_api_postgres_test
MONGO_CONTAINER_NAME=golang_api_mongodb_test

# Volume names
POSTGRES_VOLUME_NAME=postgres_test_data
MONGO_DATA_VOLUME_NAME=mongodb_test_data
MONGO_CONFIG_VOLUME_NAME=mongodb_test_config

# Network
NETWORK_NAME=golang_api_test_network

# Test connection strings (used by Go tests)
TEST_POSTGRES_DSN=postgres://postgres:test_password@localhost:5433/life_tracker_test?sslmode=disable
TEST_MONGO_URI=mongodb://test_user:test_password@localhost:27018
