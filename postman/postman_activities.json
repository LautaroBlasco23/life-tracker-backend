{
	"info": {
		"_postman_id": "activities-collection-001",
		"name": "Activities",
		"description": "Activity management endpoints for creating, tracking, and managing user activities",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Create Activity",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"if (pm.response.code === 201) {",
							"    const response = pm.response.json();",
							"    pm.environment.set('activity_id', response.data.id);",
							"    console.log('Activity ID saved to environment:', response.data.id);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{access_token}}"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"title\": \"Morning Exercise\",\n    \"description\": \"30 minutes of cardio workout\",\n    \"completionAmount\": 1,\n    \"frequency\": \"daily\",\n    \"dayTime\": \"morning\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/activities",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"activities"
					]
				},
				"description": "Create a new activity"
			},
			"response": []
		},
