		{
			"name": "Create Income Transaction",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"if (pm.response.code === 201) {",
							"    const response = pm.response.json();",
							"    pm.environment.set('transaction_id', response.data.id);",
							"    console.log('Transaction ID saved to environment:', response.data.id);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{access_token}}"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"type\": \"income\",\n    \"amount\": 5000.00,\n    \"categoryId\": 1,\n    \"subcategoryId\": 1,\n    \"description\": \"Monthly salary payment\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/finances/transactions",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"finances",
						"transactions"
					]
				},
				"description": "Create an income transaction (salary example)"
			},
			"response": []
